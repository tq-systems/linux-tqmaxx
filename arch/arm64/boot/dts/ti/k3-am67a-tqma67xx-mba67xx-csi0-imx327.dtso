#include <dt-bindings/media/video-interfaces.h>

/dts-v1/;
/plugin/;

&csi0_port0 {
	status = "okay";

	csi0_port0_in: endpoint {
		remote-endpoint = <&camera_csi0_out>;
		bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
		clock-lanes = <0>;
		data-lanes = <1 2>;
	};
};

&dphy0 {
	status = "okay";
};

&main_i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;

	vc_ctrl_csi0: controller@10 {
		compatible = "vision-components,mipi-module";
		reg = <0x10>;
		#clock-cells = <0>;
		vcc-supply = <&reg_3v3>;
		clock-frequency = <37125000>;
	};

	camera_csi0: camera@1a {
		compatible = "sony,imx327lqr";
		reg = <0x1a>;
		clocks = <&vc_ctrl_csi0>;
		clock-names = "xclk";
		clock-frequency = <37125000>;
		orientation = <2>;
		rotation = <0>;
		use-single-read;
		vdda-supply = <&vc_ctrl_csi0>;
		vddd-supply = <&vc_ctrl_csi0>;
		vdddo-supply = <&vc_ctrl_csi0>;

		port {
			camera_csi0_out: endpoint {
				remote-endpoint = <&csi0_port0_in>;
				/* Both the AM67 and the IMX327 support up to 4
				 * lanes, but only two are connected in the
				 * adapter provided in the camera kit for the
				 * MBa67xx.
				 */
				data-lanes = <1 2>;
				clock-lanes = <0>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <445500000 297000000>;
			};
		};
	};
};

&ti_csi2rx0 {
	status = "okay";
};
